# Load packages
library(tidyverse)
library(tidymodels)
seed_num <- 25
# Simulate centroids.
centroids <- tibble(cluster = factor(1:3),
x_mean = c(5, 0, -3),
y_mean = c(-1, 1, -2),
num_obs = c(100, 150, 50))
centroids
# This is a simple example
# Map is a for loop.
map(list(1, 2, 3), log)
# we will use pmap to iterate over each row
centroids
rnorm(n = 5, mean = 10, sd = 2)
set.seed(seed_num)
# Simulate observations.
sim_data <- centroids |>
mutate(
# use names in your list that the function (rnorm, in this case) expects
x = pmap(list(n = num_obs, mean = x_mean), rnorm),
y = pmap(list(n = num_obs, mean = y_mean), rnorm)
) |>
# extract the results from each iteration
unnest(c(x, y))
centroids |>
mutate(
# use names in your list that the function (rnorm, in this case) expects
x = pmap(list(n = num_obs, mean = x_mean), rnorm),
y = pmap(list(n = num_obs, mean = y_mean), rnorm)
)
set.seed(seed_num)
# Simulate observations.
sim_data <- centroids |>
mutate(
# use names in your list that the function (rnorm, in this case) expects
x = pmap(list(n = num_obs, mean = x_mean), rnorm),
y = pmap(list(n = num_obs, mean = y_mean), rnorm)
) |>
# extract the results from each iteration
unnest(c(x, y))
sim_data
# Visualize the clusters.
ggplot(sim_data, aes(x = x, y = y, color = cluster)) +
geom_point(size = 3, alpha = 0.5)
# Fit a k-means model.
set.seed(seed_num)
fit_km3 <- sim_data |>
select(x, y) |>
kmeans(centers = 3)
fit_km3
# Tidy model output.
tidy(fit_km3)
# Append predicted clusters.
(initial_clusters <- augment(fit_km3, sim_data))
# Plot the k-means solution.
ggplot(initial_clusters, aes(x = x, y = y, color = .cluster)) +
geom_point(size = 3, alpha = 0.5)
initial_clusters |>
group_by(cluster) |>
summarize(across(c(x, y), mean)) |>
rename(income = x,
age = y)
# Fit a k-means model.
set.seed(seed_num)
fit_km3 <- sim_data |>
select(x, y) |>
# add nstart argument - obtain 10 solutions, take the best one
kmeans(centers = 3, nstart = 10)
# Append predicted clusters.
better_initial_clusters <- augment(fit_km3, sim_data)
# Visualize the clusters.
ggplot(sim_data, aes(x = x, y = y, color = cluster)) +
geom_point(size = 4, alpha = 0.5)
sample(c("paige", "maggie"), 1)
# Load packages
library(tidyverse)
library(tidymodels)
seed_num <- 25
# Simulate centroids.
centroids <- tibble(cluster = factor(1:3),
x_mean = c(5, 0, -3),
y_mean = c(-1, 1, -2),
num_obs = c(100, 150, 50))
centroids
# This is a simple example
# Map is a for loop.
map(list(1, 2, 3), log)
# we will use pmap to iterate over each row
centroids
centroids |>
mutate(
# use names in your list that the function (rnorm, in this case) expects
x = pmap(list(n = num_obs, mean = x_mean), rnorm),
y = pmap(list(n = num_obs, mean = y_mean), rnorm)
)
set.seed(seed_num)
# Simulate observations.
sim_data <- centroids |>
mutate(
# use names in your list that the function (rnorm, in this case) expects
x = pmap(list(n = num_obs, mean = x_mean), rnorm),
y = pmap(list(n = num_obs, mean = y_mean), rnorm)
) |>
# extract the results from each iteration
unnest(c(x, y))
sim_data
# Visualize the clusters.
ggplot(sim_data, aes(x = x, y = y, color = cluster)) +
geom_point(size = 4, alpha = 0.5)
# Visualize the clusters.
ggplot(sim_data, aes(x = x, y = y, color = cluster)) +
geom_point(size = 3, alpha = 0.5)
# Fit a k-means model.
set.seed(seed_num)
fit_km3 <- sim_data |>
select(x, y) |>
kmeans(centers = 3)
fit_km3
# Tidy model output.
tidy(fit_km3)
# Append predicted clusters.
(initial_clusters <- augment(fit_km3, sim_data))
initial_clusters |>
group_by(cluster) |>
summarize(across(c(x, y), mean)) |>
rename(income = x,
age = y)
# Plot the k-means solution.
ggplot(initial_clusters, aes(x = x, y = y, color = .cluster)) +
geom_point(size = 3, alpha = 0.5)
# Fit a k-means model.
set.seed(seed_num)
fit_km3 <- sim_data |>
select(x, y) |>
# add nstart argument - obtain 10 solutions, take the best one
kmeans(centers = 3, nstart = 10)
# Append predicted clusters.
better_initial_clusters <- augment(fit_km3, sim_data)
# Plot the k-means solution.
ggplot(better_initial_clusters, aes(x = x, y = y, color = .cluster)) +
geom_point(size = 3, alpha = 0.5)
