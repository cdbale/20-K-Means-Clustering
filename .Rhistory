# Load packages
library(tidyverse)
library(tidymodels)
seed_num <- 25
# Simulate centroids.
centroids <- tibble(cluster = factor(1:3),
x_mean = c(5, 0, -3),
y_mean = c(-1, 1, -2),
num_obs = c(100, 150, 50))
centroids
# Load packages
library(tidyverse)
library(tidymodels)
seed_num <- 25
# Simulate centroids.
centroids <- tibble(cluster = factor(1:3),
x_mean = c(5, 0, -3),
y_mean = c(-1, 1, -2),
num_obs = c(100, 150, 50))
centroids
# This is a simple example
# Map is a for loop.
map(list(1, 2, 3), log)
# we will use pmap to iterate over each row
centroids
set.seed(seed_num)
# Simulate observations.
sim_data <- centroids |>
mutate(
# use names in your list that the function (rnorm, in this case) expects
x = pmap(list(n = num_obs, mean = x_mean), rnorm),
y = pmap(list(n = num_obs, mean = y_mean), rnorm)
) |>
# extract the results from each iteration
unnest(c(x, y))
sim_data
# Visualize the clusters.
ggplot(sim_data, aes(x = x, y = y, color = cluster)) +
geom_point(size = 3, alpha = 0.5)
# Fit a k-means model.
set.seed(seed_num)
fit_km3 <- sim_data |>
select(x, y) |>
kmeans(centers = 3)
fit_km3
# Tidy model output.
tidy(fit_km3)
# Append predicted clusters.
(initial_clusters <- augment(fit_km3, sim_data))
initial_clusters |>
group_by(cluster) |>
summarize(across(c(x, y), mean)) |>
rename(income = x,
age = y)
# Plot the k-means solution.
ggplot(initial_clusters, aes(x = x, y = y, color = .cluster)) +
geom_point(size = 3, alpha = 0.5)
# Plot the k-means solution.
ggplot(better_initial_clusters, aes(x = x, y = y, color = .cluster)) +
geom_point(size = 3, alpha = 0.5)
# Load packages
library(tidyverse)
library(tidymodels)
seed_num <- 25
# Simulate centroids.
centroids <- tibble(cluster = factor(1:3),
x_mean = c(5, 0, -3),
y_mean = c(-1, 1, -2),
num_obs = c(100, 150, 50))
centroids
# This is a simple example
# Map is a for loop.
map(list(1, 2, 3), log)
# we will use pmap to iterate over each row
centroids
set.seed(seed_num)
# Simulate observations.
sim_data <- centroids |>
mutate(
# use names in your list that the function (rnorm, in this case) expects
x = pmap(list(n = num_obs, mean = x_mean), rnorm),
y = pmap(list(n = num_obs, mean = y_mean), rnorm)
) |>
# extract the results from each iteration
unnest(c(x, y))
sim_data
# Visualize the clusters.
ggplot(sim_data, aes(x = x, y = y, color = cluster)) +
geom_point(size = 3, alpha = 0.5)
# Fit a k-means model.
set.seed(seed_num)
fit_km3 <- sim_data |>
select(x, y) |>
kmeans(centers = 3)
fit_km3
# Tidy model output.
tidy(fit_km3)
# Append predicted clusters.
(initial_clusters <- augment(fit_km3, sim_data))
initial_clusters |>
group_by(cluster) |>
summarize(across(c(x, y), mean)) |>
rename(income = x,
age = y)
# Plot the k-means solution.
ggplot(initial_clusters, aes(x = x, y = y, color = .cluster)) +
geom_point(size = 3, alpha = 0.5)
# Fit a k-means model.
set.seed(seed_num)
fit_km3 <- sim_data |>
select(x, y) |>
# add nstart argument - obtain 10 solutions, take the best one
kmeans(centers = 3, nstart = 10)
# Append predicted clusters.
better_initial_clusters <- augment(fit_km3, sim_data)
# Plot the k-means solution.
ggplot(better_initial_clusters, aes(x = x, y = y, color = .cluster)) +
geom_point(size = 3, alpha = 0.5)
# Glance at model fit.
glance(fit_km3)
set.seed(seed_num)
fit_tune <- vector(mode = "double", length = 9)
for (k in seq_along(fit_tune)) {
# Fit k-means.
fit <- sim_data |>
select(x, y) |>
kmeans(centers = k, nstart = 10)
# Extract model fit.
fit_tune[k] <- glance(fit)$tot.withinss
}
# Select the clustering variables.
sim_obs <- sim_data |>
select(x, y)
# Tune k.
set.seed(seed_num)
fit_tune <- tibble(k = 1:10) |>
mutate(
fit_km = pmap(list(centers = k), kmeans, x = sim_obs, nstart = 10),
model_fit = map(fit_km, glance)
) |>
unnest(model_fit)
fit_tune
# Load packages
library(tidyverse)
library(tidymodels)
seed_num <- 25
# Simulate centroids.
centroids <- tibble(cluster = factor(1:3),
x_mean = c(5, 0, -3),
y_mean = c(-1, 1, -2),
num_obs = c(100, 150, 50))
centroids
# This is a simple example
# Map is a for loop.
map(list(1, 2, 3), log)
# we will use pmap to iterate over each row
centroids
set.seed(seed_num)
# Simulate observations.
sim_data <- centroids |>
mutate(
# use names in your list that the function (rnorm, in this case) expects
x = pmap(list(n = num_obs, mean = x_mean), rnorm),
y = pmap(list(n = num_obs, mean = y_mean), rnorm)
) |>
# extract the results from each iteration
unnest(c(x, y))
sim_data
# Visualize the clusters.
ggplot(sim_data, aes(x = x, y = y, color = cluster)) +
geom_point(size = 3, alpha = 0.5)
# Fit a k-means model.
set.seed(seed_num)
fit_km3 <- sim_data |>
select(x, y) |>
kmeans(centers = 3)
fit_km3
# Tidy model output.
tidy(fit_km3)
# Append predicted clusters.
(initial_clusters <- augment(fit_km3, sim_data))
initial_clusters |>
group_by(cluster) |>
summarize(across(c(x, y), mean)) |>
rename(income = x,
age = y)
# Plot the k-means solution.
ggplot(initial_clusters, aes(x = x, y = y, color = .cluster)) +
geom_point(size = 3, alpha = 0.5)
# Fit a k-means model.
set.seed(seed_num)
fit_km3 <- sim_data |>
select(x, y) |>
# add nstart argument - obtain 10 solutions, take the best one
kmeans(centers = 3, nstart = 10)
# Append predicted clusters.
better_initial_clusters <- augment(fit_km3, sim_data)
# Plot the k-means solution.
ggplot(better_initial_clusters, aes(x = x, y = y, color = .cluster)) +
geom_point(size = 3, alpha = 0.5)
# Glance at model fit.
glance(fit_km3)
# Select the clustering variables.
sim_obs <- sim_data |>
select(x, y)
# Tune k.
set.seed(seed_num)
fit_tune <- tibble(k = 1:10) |>
mutate(
fit_km = pmap(list(centers = k), kmeans, x = sim_obs, nstart = 10),
model_fit = map(fit_km, glance)
) |>
unnest(model_fit)
fit_tune
# Scree plot.
ggplot(fit_tune, aes(x = k, y = tot.withinss)) +
geom_point() +
geom_line()
# Scree plot.
ggplot(fit_tune, aes(x = k, y = tot.withinss)) +
geom_point() +
geom_line()
# Augment the cluster results with the actual data points.
fit_recovery <- tibble(k = 2:7) |>
mutate(
fit_km = pmap(list(centers = k), kmeans, x = sim_obs, nstart = 10),
augment_data = map(fit_km, augment, data = sim_obs)
) |>
unnest(augment_data)
fit_recovery
# Plot each k-means solution.
ggplot(fit_recovery, aes(x = x, y = y)) +
geom_point(aes(color = .cluster), alpha = 0.5) +
facet_wrap(~ k)
